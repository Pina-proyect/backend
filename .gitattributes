# Normalización de finales de línea
# LF en el repo y en el checkout (Windows incluido). Elimina los falsos
# errores prettier/CRLF del lint local y unifica con el CI (Linux/LF).
* text=auto eol=lf

# Binarios: nunca normalizar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar.gz binary
