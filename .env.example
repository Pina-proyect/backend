# ──────────────────────────────────────────────
# PINA BACKEND — Variables de Entorno
# Copiar a .env y reemplazar valores
# ──────────────────────────────────────────────

# ── Base de Datos ─────────────────────────────
# PostgreSQL (local con Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pina_dev"
# Conexión directa (para migraciones, bypass del pooler)
DIRECT_URL=

# ── Google OAuth ──────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# En desarrollo: http://localhost:4011/api/pina/auth/google/callback
# En staging:   https://<render-url>/api/pina/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:4011/api/pina/auth/google/callback"

# ── JWT ───────────────────────────────────────
JWT_SECRET=""                              # Generar con: openssl rand -hex 32
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Seguridad ─────────────────────────────────
BCRYPT_SALT_ROUNDS="10"

# ── URLs ──────────────────────────────────────
# Frontend (Next.js por defecto corre en :3000)
FRONTEND_URL="http://localhost:3000"
# Backend (para callbacks internos)
BACKEND_URL="http://localhost:4011"
# Orígenes CORS adicionales (separados por coma)
CORS_ORIGINS=""
# Tunnel ngrok para webhooks en desarrollo
NGROK_URL=""

# ── Mercado Pago ──────────────────────────────
# Token productivo (solo en Render, no en .env local)
MP_ACCESS_TOKEN=""
# OAuth para que creadoras conecten su cuenta MP
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# Callback OAuth: https://<backend>/api/pina/payments/mercadopago/callback
MP_REDIRECT_URI=""
# Secreto para validar webhooks HMAC-SHA256
MP_WEBHOOK_SECRET=""

# ── Redis ─────────────────────────────────────
# Redis://... (local: redis://localhost:6379)
REDIS_URL=""

# ── Servidor ──────────────────────────────────
PORT=4011
NODE_ENV="development"                     # development | production | test

# ── Resend (Email) ─────────────────────────────
RESEND_API_KEY="re_..."                          # https://resend.com/api-keys
EMAIL_FROM="Pina <noreply@pina.com>"             # Debe ser dominio verificado en Resend

# ── IA Onboarding (v1.18) ──────────────────────
# Proveedor primario de LLM (Groq). Sin key → onboarding cae a modo manual (Caso D).
GROQ_API_KEY=""                                  # https://console.groq.com/keys
# Proveedor fallback (DeepSeek). Se usa si Groq falla.
DEEPSEEK_API_KEY=""                              # https://platform.deepseek.com/api_keys
# YouTube Data API v3 (solo API key, gratis) para datos de canal.
YOUTUBE_API_KEY=""
# Umbral de followers para decidir Caso A (≥umbral) vs B (<umbral). Default 1000.
AI_FOLLOWER_THRESHOLD="1000"
# Máximo de generaciones de IA por usuario cada 24h. Default 5.
AI_DAILY_LIMIT="5"
# Tope mensual de gasto en LLM (log-only en Fase 0; no bloquea).
AI_MONTHLY_BUDGET_USD=""
# Circuit breaker: fallos consecutivos antes de abrir / tiempo de reset en ms.
AI_CB_FAILURE_THRESHOLD="3"
AI_CB_RESET_MS="30000"

# ── Storage Cloudflare R2 (Sprint 2) ───────────
# Driver: local (uploads/ en disco, dev) | r2 (Cloudflare, default en producción).
STORAGE_DRIVER="local"
# Cloudflare R2 → R2 Overview → Account ID (derecha)
R2_ACCOUNT_ID=""
# Cloudflare R2 → Manage R2 API Tokens → Access Key ID / Secret Access Key
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Bucket privado (videos protegidos) y bucket público (covers/imágenes)
R2_BUCKET="pina-private"
R2_PUBLIC_BUCKET="pina-public"
# URL pública del bucket (p. ej. https://pub.<account>.r2.dev o custom domain)
R2_PUBLIC_URL=""
# Endpoint S3 (por defecto se deriva de R2_ACCOUNT_ID)
R2_ENDPOINT=""
# Nota: en el dashboard de Cloudflare R2 configurar CORS del bucket privado
# para GET/HEAD con Range y permitir el dominio del frontend (para Range requests).

# ── Prisma (opcional) ─────────────────────────
# Prisma connection pool settings
PRISMA_CLIENT_CONNECTION_LIMIT=10
PRISMA_CLIENT_POOL_TIMEOUT=10
